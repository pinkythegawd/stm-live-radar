# Copy this file to `.env` and fill in your own credentials.
# `.env` is git-ignored.

# STM Open Data — https://portail.developpementdurable.stm.info/
STM_API_KEY=your_stm_api_key_here

PORT=4173

# Optional: pinkythegawd / MikePinku JSON API.
# When set it is tried first; STM GTFS-Realtime remains the fallback.
CUSTOM_API_BASE_URL=
CUSTOM_API_VEHICLES_PATH=/vehicles
CUSTOM_API_ALERTS_PATH=/alerts
CUSTOM_API_KEY=
CUSTOM_API_KEY_HEADER=x-api-key
CUSTOM_API_KEY_PREFIX=

VEHICLES_CACHE_MS=8000
ALERTS_CACHE_MS=60000
LOG_REQUESTS=true
